# SocraticMath AI Configuration Example
# Text model for Review & Socratic Tutor
TEXT_MODEL=openai/gpt-oss-120b

# Vision model for Whiteboard Image-to-Text
VISION_MODEL=qwen/qwen3.8-27b

# API Keys & Base URL (supports Groq, OpenRouter, or OpenAI compatible)
GROQ_API_KEY=
OPENAI_API_KEY=
AI_API_KEY=
AI_BASE_URL=

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=socratic_tutor
MAX_HINT_LIMIT=6

# Frontend Backend Connection URL
VITE_API_BASE_URL=http://localhost:8000
